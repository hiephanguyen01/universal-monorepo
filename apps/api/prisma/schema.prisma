generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  fullName     String
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  version      Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model OutboxEvent {
  id            String   @id @default(cuid())
  eventName     String
  payload       Json
  occurredAt    DateTime
  processedAt   DateTime?
  processingAt  DateTime?
  nextAttemptAt DateTime @default(now())
  attempts      Int      @default(0)
  lastError     String?
  failedAt      DateTime?
  createdAt     DateTime @default(now())

  @@index([processedAt, failedAt, nextAttemptAt])
  @@index([processingAt])
  @@index([createdAt])
}

model InboxEvent {
  id           String   @id @default(cuid())
  eventId      String
  handlerName  String
  processingAt DateTime?
  processedAt  DateTime?
  attempts     Int      @default(0)
  lastError    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([eventId, handlerName])
  @@index([processedAt])
  @@index([processingAt])
}

model IdempotencyRecord {
  id          String   @id @default(cuid())
  scope       String
  key         String
  requestHash String
  response    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, key])
  @@index([createdAt])
}
